---
import { symbols, ui } from "@util/siteData"
---

<div class="logo-content-parent container mx-auto px-4">
	<div class="separador-logo">
		<img src={ui.symbolSeparator} alt="" />
	</div>
	{
		symbols.map((symbol) => (
			<div class="flex items-center justify-center">
				<img src={symbol.src} alt={symbol.alt} class="w-full h-auto" />
			</div>
		))
	}
	<div class="separador-logo">
		<img src={ui.symbolSeparator} alt="" />
	</div>
</div>
