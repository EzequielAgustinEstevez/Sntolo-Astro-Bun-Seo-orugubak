---
import { tracks, ui } from "@util/siteData"
---

<div class="container mx-auto px-2">
	<div class="flex justify-center">
		<img
			src={ui.oraculoDesktop}
			class="hidden md:block max-w-full h-auto"
			alt="Tabla del oráculo mudo"
		/>
		<img
			src={ui.oraculoMobile}
			class="block md:hidden max-w-full h-auto"
			alt="Tabla del oráculo mudo"
		/>
	</div>

	<div class="player-row py-4">
		{
			tracks.map((track, index) => (
				<>
					<div class="player-column flex flex-col justify-center pt-1 px-2">
						<img src={track.image} class="max-h-36 w-auto mx-auto" alt={track.title} />
						<p class="mb-0 mt-3 whitespace-nowrap text-[var(--color-primary)]">
							{track.label}
						</p>
						<div class="flex items-center justify-center mt-3">
							<button
								type="button"
								class="play-button flex flex-col items-center"
								data-image={track.image}
								data-text={track.label}
								data-audio-src={track.audio}
								aria-label={`Reproducir ${track.title}`}
							>
								<img src={ui.playButton} class="h-auto max-w-full" alt="" />
								<span class="mt-1 text-[var(--color-primary)] whitespace-nowrap">
									Reproducir
								</span>
							</button>
							<img
								src={ui.separator}
								class="h-auto max-w-full mx-2 max-h-16"
								alt=""
							/>
							<button
								type="button"
								class="download-button flex flex-col items-center"
								data-download-src={track.audio}
								data-download-text={track.downloadName}
								aria-label={`Descargar ${track.title}`}
							>
								<img src={ui.downloadButton} class="h-auto max-w-full" alt="" />
								<span class="mt-1 text-[var(--color-primary)] whitespace-nowrap">
									Descargar
								</span>
							</button>
						</div>
					</div>
					{index < tracks.length - 1 && (
						<div class="flex-shrink-0 flex items-center justify-center px-1">
							<img
								src={ui.verticalDivisor}
								class="vertical-divisor h-auto"
								alt=""
							/>
						</div>
					)}
				</>
			))
		}
	</div>
</div>

<!-- Fixed bottom player -->
<div id="playerId" class="player-bar" hidden>
	<div class="player-head">
		<img src="" class="player-img" alt="" id="playerImage" width="96" height="96" />
		<h3 class="mb-0 mt-0 text-[var(--color-primary)] text-xl md:text-2xl">
			<span id="playerTitle"></span>
		</h3>
		<button type="button" class="close-button" id="closeButton" aria-label="Cerrar reproductor">
			X
		</button>
	</div>
	<audio id="sntoloAudio" class="sntolo-audio" controls preload="none">
		<source src="" type="audio/mpeg" />
		Tu navegador no soporta audio HTML5.
	</audio>
</div>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const playerBar = document.getElementById("playerId")
		const playerImage = document.getElementById("playerImage") as HTMLImageElement | null
		const playerTitle = document.getElementById("playerTitle")
		const audio = document.getElementById("sntoloAudio") as HTMLAudioElement | null
		const closeButton = document.getElementById("closeButton")

		document.querySelectorAll(".play-button").forEach((button) => {
			button.addEventListener("click", () => {
				const el = button as HTMLElement
				const audioSrc = el.getAttribute("data-audio-src")
				const imageSrc = el.getAttribute("data-image")
				const text = el.getAttribute("data-text")

				if (!playerBar || !audio || !playerImage || !playerTitle || !audioSrc) return

				playerBar.hidden = false
				playerImage.src = imageSrc || ""
				playerTitle.textContent = text || ""

				const source = audio.querySelector("source")
				if (source) {
					source.src = audioSrc
					audio.load()
					audio.play().catch(() => {
						/* autoplay may be blocked until user gesture — click is a gesture */
					})
				}
			})
		})

		closeButton?.addEventListener("click", () => {
			if (!playerBar || !audio) return
			audio.pause()
			playerBar.hidden = true
		})

		document.querySelectorAll(".download-button").forEach((button) => {
			button.addEventListener("click", () => {
				const el = button as HTMLElement
				const downloadSrc = el.getAttribute("data-download-src")
				const downloadText = el.getAttribute("data-download-text") || "track"
				if (!downloadSrc) return

				const link = document.createElement("a")
				link.href = downloadSrc
				link.download = downloadText
				link.target = "_blank"
				link.rel = "noopener"
				link.click()
			})
		})
	})
</script>
