---
export interface Props {
	/** Highlight Home link in primary color (character pages). */
	highlightHome?: boolean
}

const { highlightHome = false } = Astro.props as Props
---

<nav class="site-nav" aria-label="Navegación principal">
	<ul class="flex flex-wrap items-center justify-center gap-2 py-3 list-none m-0 p-0 md:gap-6">
		<li>
			<a
				href="/"
				class:list={[
					"responsive-font block px-2 py-1",
					highlightHome ? "text-[var(--color-primary)]" : "text-white"
				]}
			>
				• Home •
			</a>
		</li>
		<li>
			<a href="/#oraculo-mudo" class="responsive-font block px-2 py-1 text-white">
				• Música •
			</a>
		</li>
		<li>
			<a href="/#fotos" class="responsive-font block px-2 py-1 text-white">
				• Fotos •
			</a>
		</li>
	</ul>
</nav>
